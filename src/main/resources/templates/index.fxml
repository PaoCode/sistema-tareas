         <font>
            <Font name="System Bold" size="25.0" />
         </font></Label>
      <TableView fx:id="tareaTabla" layoutX="274.0" layoutY="91.0" onMouseClicked="#cargarTareaFormulario" prefHeight="197.0" prefWidth="382.0">
        <columns>
          <TableColumn fx:id="idTareaColumna" prefWidth="46.0" text="ID" />
          <TableColumn fx:id="nombreTareaColumna" prefWidth="146.0" text="Tarea" />
            <TableColumn fx:id="responsableColumna" prefWidth="95.0" text="Responsable" />
            <TableColumn fx:id="estatusColumna" prefWidth="94.0" text="Estatus" />
        </columns>
      </TableView>
      <AnchorPane layoutX="48.0" layoutY="91.0" prefHeight="197.0" prefWidth="200.0">
