            <TextField fx:id="nombreTareaTexto" layoutX="26.0" layoutY="38.0" />
            <TextField fx:id="responsableTexto" layoutX="26.0" layoutY="99.0" />
            <TextField fx:id="estatusTexto" layoutX="26.0" layoutY="155.0" />
         </children>
      </AnchorPane>
      <AnchorPane layoutX="41.0" layoutY="325.0" prefHeight="74.0" prefWidth="591.0">
