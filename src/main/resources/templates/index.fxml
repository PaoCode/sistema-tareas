            <Button fx:id="agregarBoton" layoutX="47.0" layoutY="25.0" mnemonicParsing="false" onAction="#agregarTarea" prefHeight="25.0" prefWidth="74.0" style="-fx-background-color: #1d3557;" text="Agregar" textFill="#f1faee" />
            <Button fx:id="modificarBoton" layoutX="162.0" layoutY="25.0" mnemonicParsing="false" onAction="#modificarTarea" prefHeight="25.0" prefWidth="80.0" style="-fx-background-color: #1d3557;" text="Modificar" textFill="#f1faee" />
            <Button fx:id="eliminarBoton" layoutX="295.0" layoutY="25.0" mnemonicParsing="false" onAction="#eliminarTarea" prefHeight="25.0" prefWidth="74.0" style="-fx-background-color: #e63946;" text="Eliminar" textFill="#f1faee" />
            <Button fx:id="limpiarBoton" layoutX="423.0" layoutY="25.0" mnemonicParsing="false" onAction="#limpiarFormulario" prefHeight="25.0" prefWidth="116.0" style="-fx-background-color: #ffd60a;" text="Limpiar Formulario" />
